# ------------------------------------------------------------
# Nuvomailo | Git ignore rules
# ------------------------------------------------------------

# Node.js dependencies and package manager caches
node_modules/
.npm/
.pnpm-store/

# Build artifacts and coverage
**/dist/
**/build/
**/coverage/
*.tsbuildinfo

# Local environment variables (examples may be committed)
.env
.env.*
!.env.example
!**/.env.example

# Secrets, private keys, and runtime mail credentials
*.pem
*.key
*.p12
*.pfx
*.jks
postfix-accounts.cf
postfix-virtual.cf

# Local volumes, mail storage, and database data
**/docker-data/
**/mail-data/
**/mail-state/
**/mail-logs/
**/postgres-data/
**/postgres_data/
**/mail_data/
**/mail_state/
**/mail_logs/
**/backups/

# Logs and local temporary files
*.log
logs/
tmp/
*.tmp

# Editor and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Treat all configuration/secrets before commit as untrusted;
# gitignore alone is not a secret-scanning guarantee.
